# Local, deidentified research only. Start uvicorn with --host 127.0.0.1 --workers 1.
SEWS_AI_REPO_ROOT=/absolute/path/to/AI
SEWS_DATABASE_PATH=/absolute/path/to/Backend/data/sews.sqlite
# Empty token permits local development access; not clinical authentication.
SEWS_API_TOKEN=
SEWS_ACTOR=local-user
